# ── TTS Provider ─────────────────────────────────────────────
# "vbee" = Vbee TTS (cần tài khoản) | "edge" = Edge TTS (miễn phí, pure Node.js via edge-tts-universal)
# "gemini" = Gemini TTS (cần GEMINI_API_KEY, tài khoản Google AI Studio)
TTS_PROVIDER=edge

# ── Edge TTS (chỉ cần khi TTS_PROVIDER=edge) ────────────────
# vi-VN-NamMinhNeural (nam) | vi-VN-HoaiMyNeural (nữ)
EDGE_VOICE=vi-VN-NamMinhNeural

# ── Vbee TTS (chỉ cần khi TTS_PROVIDER=vbee) ────────────────
VBEE_APP_ID=
VBEE_ACCESS_TOKEN=
# Giọng đọc Vbee — danh sách khác xem vbee.md hoặc trên trang chủ vbee § 5
VBEE_VOICE_CODE=

# ── Gemini TTS (chỉ cần khi TTS_PROVIDER=gemini) ────────────
# Có thể để nhiều key cách nhau bằng dấu phẩy — script tự chuyển key khi key
# hiện tại hết quota miễn phí trong ngày (lỗi 429 / RESOURCE_EXHAUSTED)
GEMINI_API_KEY=
# Giọng dựng sẵn (prebuilt voice) của Gemini — ví dụ: Achird, Puck, Kore, Charon,
# Leda, Orus, Zephyr...
GEMINI_TTS_VOICE=Achird



# ── Video series ─────────────────────────────────────────────
# Tên kênh hiển thị trên eyebrow tag (#eyebrow) trong mọi video
CHANNEL=Cường IT

# 0 = skill dừng lại xác nhận từng bước | 1 = chạy tự động không hỏi
AUTO_CREATE_VIDEO=0